@PACKAGE_INIT@

set(EXPORT_NAME @PROJECT_NAME@_targets)
set(ABI_TAG_ADDED @ADD_ABI_TAG@)

if (MSVC AND ABI_TAG_ADDED)
  set(_rt_id "")
  if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "DLL")
    set(_rt_id "mt")
  else()
    set(_rt_id "md")
  endif()
  string(APPEND EXPORT_NAME "-${_rt_id}")
endif()

if (SMBIOS_USE_STATIC_LIBS)
  string(APPEND EXPORT_NAME "-static")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/${EXPORT_NAME}.cmake")
